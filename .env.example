# ==============================================================================
# AI Crop Advisor & Disease Detector - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your keys if you want to enable external
# LLM providers (e.g., Google Gemini or OpenAI).
# If no API key is set, the system gracefully operates in 'local' expert mode,
# using the offline agricultural knowledge engine and trained ML models.
# ==============================================================================

# LLM Provider: 'auto', 'gemini', 'openai', or 'local'
CHATBOT_PROVIDER=auto

# Google Gemini API Key (Recommended for high speed & free tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model choice: e.g. 'gemini-1.5-flash', 'gemini-2.0-flash', etc.
CHATBOT_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Flask Environment
FLASK_ENV=development
